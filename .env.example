# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for canonical links, self-referential links, and API endpoints.
APP_URL="MY_APP_URL"

# Optional External SEO Data Providers (for future live search volume integrations)
SEO_API_KEY=""
SERP_API_KEY=""

# Optional Analytics & Newsletter Integration
GA_MEASUREMENT_ID=""
NEWSLETTER_API_KEY=""
